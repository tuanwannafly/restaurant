<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.restaurant</groupId>
    <artifactId>smart-restaurant</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Smart Restaurant</name>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>17.0.11</javafx.version>

        <!-- ── SonarQube ──────────────────────────────────────── -->
        <!-- Đặt qua env var hoặc Maven settings.xml, KHÔNG hardcode -->
        <!-- mvn sonar:sonar -Dsonar.host.url=... -Dsonar.token=... -->
        <sonar.projectKey>smart-restaurant</sonar.projectKey>
        <sonar.projectName>SmartRestaurant</sonar.projectName>
        <sonar.java.source>17</sonar.java.source>
        <sonar.sources>src/main/java</sonar.sources>
        <sonar.tests>src/test/java</sonar.tests>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.reporting.outputDirectory}/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/module-info.java,target/**</sonar.exclusions>

        <!-- ── JaCoCo ────────────────────────────────────────── -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencies>

        <!-- ══════════════════════════════════════════════════════
             JavaFX — scope=compile để Maven tải về và VS Code tìm thấy.

             Nếu dùng Liberica JDK Full: JavaFX đã có built-in,
             nhưng jar Maven vẫn cần thiết khi biên dịch qua Maven.
             Nếu dùng JDK thường (Temurin/OpenJDK): jar này là bắt buộc.
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             Oracle JDBC (bao gồm DCN)
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.4.0.24.05</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.nls</groupId>
            <artifactId>orai18n</artifactId>
            <version>23.4.0.24.05</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             SQLite JDBC — yêu cầu bởi module-info.java
             (FIX: thiếu trong pom.xml trước)
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             HikariCP — Connection Pool
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- SLF4J backend cho HikariCP -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             Java-WebSocket
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.7</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             Jakarta Mail
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             Jackson
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>
        <!-- FIX: thiếu trong pom.xml trước — dùng trong module-info.java -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.17.1</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             BCrypt
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             JUnit 5 — Unit Test (cần cho JaCoCo coverage)
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ── Compiler ───────────────────────────────────── -->
            <!--
                maven-compiler-plugin 3.11+ tự động đặt dependency lên
                MODULE PATH khi project có module-info.java.
                Không cần cấu hình thêm nếu dùng phiên bản này trở lên.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- ── Copy tất cả dependency ra thư mục libs ────── -->
            <!--
                KHÔNG dùng shade (fat JAR) với JPMS — shade plugin loại bỏ
                module-info.java khi merge nhiều module → module system bị phá.

                Thay vào đó: JAR ứng dụng nhỏ + thư mục libs/ chứa tất cả dep.
                Chạy bằng: java -p libs:app.jar -m com.restaurant/com.restaurant.Main
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ── JAR plugin — Main-Class trong MANIFEST ────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.restaurant.Main</mainClass>
                        </manifest>
                    </archive>
                    <finalName>smart-restaurant-${project.version}</finalName>
                </configuration>
            </plugin>

            <!-- ── JaCoCo — đo coverage cho SonarQube ────────── -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- Cài agent trước khi test chạy -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <!-- Sinh XML report sau khi test xong -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!-- Fail build nếu coverage dưới ngưỡng -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <!-- Tối thiểu 60% line coverage toàn project -->
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ── SonarQube Maven Plugin ─────────────────────── -->
            <!--
                Cách chạy:
                  mvn verify sonar:sonar \
                    -Dsonar.host.url=http://localhost:9000 \
                    -Dsonar.token=$SONAR_TOKEN

                Hoặc để CI tự chạy (xem .github/workflows/ci.yml)
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>4.0.0.4121</version>
            </plugin>

        </plugins>
    </build>

</project>