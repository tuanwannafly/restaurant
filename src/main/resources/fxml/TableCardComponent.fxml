<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!--
  TableCardComponent.fxml  —  Phase 5
  Uses fx:root pattern: TableCardController extends VBox.
  Layout (top → bottom):
    ┌──────────────────────┐
    │  [status color bar]  │  6 px
    │  Table name (bold)   │
    │  👥  capacity        │
    │  [status badge]      │
    │  ── flex space ──    │
    │  [🗑] [✏] [👁]      │  action strip
    └──────────────────────┘
-->
<fx:root type="VBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         prefWidth="172" prefHeight="200"
         styleClass="table-card"
         onMouseClicked="#onCardClicked">

    <!-- ── Status color bar (top accent) ──────────────────────────────── -->
    <HBox fx:id="statusBar" prefHeight="6" styleClass="card-status-bar">
        <padding><Insets/></padding>
    </HBox>

    <!-- ── Body ────────────────────────────────────────────────────────── -->
    <VBox VBox.vgrow="ALWAYS" spacing="6" styleClass="card-body">
        <padding><Insets top="12" right="12" bottom="8" left="12"/></padding>

        <!-- Table name -->
        <Label fx:id="lblName" styleClass="card-table-name"
               maxWidth="Infinity" wrapText="false" ellipsisString="…"/>

        <!-- Capacity row -->
        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="👥" style="-fx-font-size: 12px;"/>
            <Label fx:id="lblCapacity" styleClass="card-caption"/>
        </HBox>

        <!-- Status badge -->
        <HBox>
            <Label fx:id="lblStatus" styleClass="card-status-badge"/>
        </HBox>
    </VBox>

    <!-- ── Flex spacer ──────────────────────────────────────────────────── -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- ── Action strip ────────────────────────────────────────────────── -->
    <HBox spacing="4" alignment="CENTER" styleClass="card-actions">
        <padding><Insets top="6" right="8" bottom="8" left="8"/></padding>

        <Button fx:id="btnDelete"
                text="🗑"
                styleClass="card-btn-danger"
                onAction="#onDelete"
                focusTraversable="false">
            <tooltip><Tooltip text="Xóa bàn"/></tooltip>
        </Button>

        <Button fx:id="btnEdit"
                text="✏"
                styleClass="card-btn-primary"
                onAction="#onEdit"
                focusTraversable="false">
            <tooltip><Tooltip text="Cập nhật bàn"/></tooltip>
        </Button>

        <Button fx:id="btnDetail"
                text="👁"
                styleClass="card-btn-info"
                onAction="#onDetail"
                focusTraversable="false">
            <tooltip><Tooltip text="Xem chi tiết"/></tooltip>
        </Button>
    </HBox>

</fx:root>
