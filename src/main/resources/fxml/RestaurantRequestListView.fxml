<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  RestaurantRequestListView.fxml — Phase 3
  ─────────────────────────────────────────────────────────────────────────────
  Màn hình danh sách đơn đăng ký nhà hàng dành cho SUPER_ADMIN.

  Sections:
    • NORTH  — Tiêu đề + thanh tìm kiếm / lọc theo status
    • CENTER — TableView với cột: ID, Tên NHÀ HÀNG, Chủ sở hữu, Email, Ngày nộp, Trạng thái, Hành động
    • SOUTH  — Phân trang + tổng số

  Controller: RestaurantRequestListController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurant.ui.fx.controller.RestaurantRequestListController"
            styleClass="bg-page">

    <!-- ── NORTH: Tiêu đề + thanh tìm kiếm / lọc ──────────────────────── -->
    <top>
        <VBox spacing="12">
            <padding><Insets top="24" right="40" bottom="16" left="40"/></padding>

            <!-- Row 1: Tiêu đề -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Đơn đăng ký" styleClass="page-title"/>
                    <Label text="Xem và xét duyệt toàn bộ đơn đăng ký mở nhà hàng"
                           style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                </VBox>
                <!-- Badge tổng pending — cập nhật bởi controller -->
                <Label fx:id="lblPendingBadge" text=""
                       style="-fx-font-size: 12px; -fx-font-weight: bold;
                              -fx-text-fill: #D97706;
                              -fx-background-color: #FEF3C7;
                              -fx-padding: 4 12 4 12;
                              -fx-background-radius: 12;"/>
            </HBox>

            <!-- Row 2: Search + Filter bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">

                <TextField fx:id="txtSearch"
                           promptText="🔍  Tìm theo tên nhà hàng hoặc email chủ..."
                           prefWidth="320" prefHeight="36"
                           onAction="#handleSearch"
                           style="-fx-background-radius: 6; -fx-border-radius: 6;
                                  -fx-border-color: #D1D5DB;"/>

                <Button fx:id="btnSearch" text="Tìm"
                        styleClass="btn-outline" onAction="#handleSearch"
                        prefWidth="60" prefHeight="36"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Trạng thái:" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
                <ComboBox fx:id="cboStatus" prefWidth="160" prefHeight="36"/>

                <Button fx:id="btnFilter" text="Áp dụng"
                        styleClass="btn-outline" onAction="#handleFilter"
                        prefWidth="80" prefHeight="36"/>

                <Button fx:id="btnRefresh" text="↻ Làm mới"
                        styleClass="btn-outline" onAction="#handleRefresh"
                        prefWidth="90" prefHeight="36"/>
            </HBox>

            <!-- Divider -->
            <Separator/>
        </VBox>
    </top>

    <!-- ── CENTER: Bảng dữ liệu hoặc empty state ─────────────────────────── -->
    <center>
        <StackPane fx:id="tableArea">
            <padding><Insets top="0" right="40" bottom="0" left="40"/></padding>

            <!-- TableView -->
            <TableView fx:id="tableView"
                       tableMenuButtonVisible="false"
                       style="-fx-background-color: white;
                              -fx-border-color: #E5E7EB;
                              -fx-border-radius: 10;
                              -fx-background-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId"          text="ID"            prefWidth="64"  minWidth="54" maxWidth="80"/>
                    <TableColumn fx:id="colRestaurant"  text="Tên nhà hàng"  prefWidth="200" minWidth="150"/>
                    <TableColumn fx:id="colOwner"       text="Chủ sở hữu"    prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="colEmail"       text="Email"         prefWidth="190" minWidth="140"/>
                    <TableColumn fx:id="colDate"        text="Ngày nộp"      prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colStatus"      text="Trạng thái"    prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colAction"      text="Hành động"     prefWidth="130" minWidth="120"/>
                </columns>
                <placeholder>
                    <Label text=""/>
                </placeholder>
            </TableView>

            <!-- Empty state -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="14"
                  visible="false" managed="false">
                <Label text="📋" style="-fx-font-size: 52px;"/>
                <Label text="Không có đơn đăng ký nào"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: #6B7280;"/>
                <Label fx:id="emptyHint" text="Chưa có đơn nào được nộp"
                       style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
        </StackPane>
    </center>

    <!-- ── SOUTH: Phân trang + Tổng số ──────────────────────────────────────── -->
    <bottom>
        <HBox fx:id="paginationBox" alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="12" right="40" bottom="20" left="40"/></padding>
            <Label fx:id="lblTotal" text="" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
