<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<!--
  LoginView.fxml — SmartRestaurant  (Redesigned v2.1)
  Window size: 500 × 660
-->
<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    styleClass="login-root"
    stylesheets="@login.css">

    <VBox>
        <Region styleClass="login-brand-band" VBox.vgrow="NEVER" prefHeight="272"/>
        <Region styleClass="login-form-band"  VBox.vgrow="ALWAYS"/>
    </VBox>

    <StackPane StackPane.alignment="TOP_CENTER" styleClass="login-deco-ring-outer"
               prefWidth="260" prefHeight="260"
               translateY="-60" mouseTransparent="true"/>

    <VBox alignment="TOP_CENTER" spacing="0" StackPane.alignment="TOP_CENTER">

        <!-- ════ HEADER ════ -->
        <VBox alignment="CENTER" spacing="10" prefHeight="250"
              styleClass="login-header">
            <StackPane styleClass="login-logo-ring">
                <Label text="🍽" styleClass="login-logo-icon"/>
            </StackPane>
            <Label text="SmartRestaurant" styleClass="login-app-name"/>
            <Label text="Hệ thống quản lý nhà hàng thông minh"
                   styleClass="login-app-subtitle"/>
        </VBox>

        <!-- ════ CARD FORM ════ -->
        <VBox styleClass="login-card" spacing="0" VBox.vgrow="ALWAYS">

            <Region prefHeight="28"/>
            <Label text="Đăng nhập" styleClass="login-card-title"/>
            <Region prefHeight="6"/>
            <Label text="Vui lòng nhập thông tin tài khoản của bạn"
                   styleClass="login-card-hint"/>
            <Region prefHeight="26"/>

            <!-- Email -->
            <Label text="Email" styleClass="login-field-label"/>
            <Region prefHeight="8"/>
            <HBox styleClass="login-field-box" fx:id="boxEmail">
                <Label text="✉" styleClass="login-field-icon"/>
                <TextField fx:id="tfEmail"
                           promptText="Nhập địa chỉ email"
                           styleClass="login-text-field"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region prefHeight="20"/>

            <!-- Mật khẩu -->
            <Label text="Mật khẩu" styleClass="login-field-label"/>
            <Region prefHeight="8"/>
            <HBox styleClass="login-field-box" fx:id="boxPassword">
                <Label text="🔒" styleClass="login-field-icon"/>
                <PasswordField fx:id="pfPassword"
                               promptText="Nhập mật khẩu"
                               styleClass="login-text-field"
                               HBox.hgrow="ALWAYS"/>
                <TextField fx:id="tfPasswordVisible"
                           promptText="Nhập mật khẩu"
                           styleClass="login-text-field"
                           HBox.hgrow="ALWAYS"
                           visible="false"
                           managed="false"/>
                <Button fx:id="btnTogglePass"
                        text="👁"
                        styleClass="login-toggle-pass-btn"
                        onAction="#onTogglePassword"
                        focusTraversable="false"/>
            </HBox>

            <Region prefHeight="16"/>

            <!-- Ghi nhớ + Quên mật khẩu -->
            <HBox alignment="CENTER_LEFT">
                <CheckBox fx:id="chkRemember"
                          text="Ghi nhớ đăng nhập"
                          styleClass="login-remember-check"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnForgot"
                        text="Quên mật khẩu?"
                        styleClass="login-link-btn"
                        onAction="#onForgotPassword"/>
            </HBox>

            <Region prefHeight="20"/>

            <!-- Lỗi -->
            <Label fx:id="lblError"
                   styleClass="login-error-label"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

            <!-- Nút đăng nhập -->
            <Button fx:id="btnLogin"
                    text="ĐĂNG NHẬP"
                    styleClass="login-btn-primary"
                    maxWidth="Infinity"
                    onAction="#onLogin"/>

            <Region prefHeight="18"/>

            <!-- ── Divider "hoặc" ─────────────────────────────────────── -->
            <HBox alignment="CENTER" spacing="10">
                <Region HBox.hgrow="ALWAYS"
                        style="-fx-border-color: #DDE3EE; -fx-border-width: 0 0 1 0; -fx-max-height: 1; -fx-pref-height: 1;"/>
                <Label text="hoặc" styleClass="login-divider-text"/>
                <Region HBox.hgrow="ALWAYS"
                        style="-fx-border-color: #DDE3EE; -fx-border-width: 0 0 1 0; -fx-max-height: 1; -fx-pref-height: 1;"/>
            </HBox>

            <Region prefHeight="18"/>

            <!-- Nút đăng nhập bàn ăn -->
            <Button text="  Đăng nhập bàn ăn"
                    styleClass="login-btn-secondary"
                    maxWidth="Infinity"
                    onAction="#onTableLogin"/>

            <Region prefHeight="24"/>

            <!-- Link Đăng ký -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="Chưa có tài khoản nhà hàng?"
                       styleClass="login-footer-text"/>
                <Button fx:id="btnRegister"
                        text="Đăng ký ngay"
                        styleClass="login-link-btn-accent"
                        onAction="#onRegister"/>
            </HBox>

            <Region prefHeight="24"/>
        </VBox>

    </VBox>

</StackPane>
