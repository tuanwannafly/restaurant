<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<!--
  LoginView.fxml — SmartRestaurant
  Window size: 440 × 560 (set in Main.java, stage.setResizable(false))

  Layout:
    ┌────────────────────────────────────────┐
    │  HEADER  (dark navy + orange accent)   │  ≈ 195 px
    │   🍽  SmartRestaurant                  │
    │   Hệ thống quản lý nhà hàng            │
    ├────────────────────────────────────────┤
    │  FORM CARD  (white, rounded top)       │  flex
    │   ─── Đăng nhập ────                   │
    │   [Email              ]                │
    │   [Mật khẩu         👁]                │
    │   ☐ Ghi nhớ đăng nhập                  │
    │   [ ĐĂNG NHẬP        ]  (orange btn)   │
    │   lblError (hidden)                    │
    │   Quên mật khẩu        Đăng ký        │
    └────────────────────────────────────────┘
-->
<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    styleClass="login-root"
    stylesheets="@login.css">

    <!-- ── Background: two-tone vertical split ── -->
    <VBox>
        <!-- TOP: dark brand band -->
        <Region styleClass="login-brand-band" VBox.vgrow="NEVER"
                prefHeight="230"/>
        <!-- BOTTOM: light form area -->
        <Region styleClass="login-form-band" VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- ── Foreground content ── -->
    <VBox alignment="TOP_CENTER" spacing="0" StackPane.alignment="TOP_CENTER">

        <!-- ══ HEADER ════════════════════════════════════════════════════════ -->
        <VBox alignment="CENTER" spacing="8" prefHeight="210"
              styleClass="login-header">

            <!-- Logo badge -->
            <StackPane styleClass="login-logo-ring">
                <Label text="🍽" styleClass="login-logo-icon"/>
            </StackPane>

            <Label text="SmartRestaurant" styleClass="login-app-name"/>
            <Label text="Hệ thống quản lý nhà hàng" styleClass="login-app-subtitle"/>
        </VBox>

        <!-- ══ CARD ═══════════════════════════════════════════════════════════ -->
        <VBox styleClass="login-card" spacing="0" VBox.vgrow="ALWAYS">

            <!-- Card title -->
            <Region prefHeight="8"/>
            <Label text="Đăng nhập" styleClass="login-card-title"/>
            <Label text="Vui lòng nhập thông tin tài khoản của bạn"
                   styleClass="login-card-hint"/>

            <Region prefHeight="20"/>

            <!-- ── Email field ── -->
            <Label text="Email" styleClass="login-field-label"/>
            <Region prefHeight="6"/>
            <HBox styleClass="login-field-box" fx:id="boxEmail">
                <TextField fx:id="tfEmail"
                           promptText="Nhập địa chỉ email"
                           styleClass="login-text-field"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region prefHeight="16"/>

            <!-- ── Password field ── -->
            <Label text="Mật khẩu" styleClass="login-field-label"/>
            <Region prefHeight="6"/>
            <HBox styleClass="login-field-box" fx:id="boxPassword">
                <PasswordField fx:id="pfPassword"
                               promptText="Nhập mật khẩu"
                               styleClass="login-text-field"
                               HBox.hgrow="ALWAYS"/>
                <TextField fx:id="tfPasswordVisible"
                           promptText="Nhập mật khẩu"
                           styleClass="login-text-field"
                           HBox.hgrow="ALWAYS"
                           visible="false"
                           managed="false"/>
                <Button fx:id="btnTogglePass"
                        text="👁"
                        styleClass="login-toggle-pass-btn"
                        onAction="#onTogglePassword"
                        focusTraversable="false"/>
            </HBox>

            <Region prefHeight="14"/>

            <!-- ── Remember me ── -->
            <CheckBox fx:id="chkRemember"
                      text="Ghi nhớ đăng nhập"
                      styleClass="login-remember-check"/>

            <Region prefHeight="20"/>

            <!-- ── Error label ── -->
            <Label fx:id="lblError"
                   styleClass="login-error-label"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

            <!-- ── Login button ── -->
            <Button fx:id="btnLogin"
                    text="ĐĂNG NHẬP"
                    styleClass="login-btn-primary"
                    maxWidth="Infinity"
                    onAction="#onLogin"/>

            <Region prefHeight="16"/>

            <!-- ── Bottom links ── -->
            <HBox alignment="CENTER">
                <Button fx:id="btnForgot"
                        text="Quên mật khẩu?"
                        styleClass="login-link-btn"
                        onAction="#onForgotPassword"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRegister"
                        text="Đăng ký nhà hàng"
                        styleClass="login-link-btn"
                        onAction="#onRegister"/>
            </HBox>

            <Region prefHeight="24"/>
        </VBox>

    </VBox>

</StackPane>
