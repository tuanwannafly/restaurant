<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    ReportAddDialog.fxml  — Phase 11
    Dialog gửi báo cáo mới. Controller: com.restaurant.ui.dialog.ReportAddController
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.ui.dialog.ReportAddController"
      spacing="0"
      style="-fx-background-color: white; -fx-min-width: 460px;">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-padding: 20 24 16 24; -fx-background-color: #F9FAFB;
                 -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
        <Label text="Gửi báo cáo mới"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px;
                      -fx-font-weight: bold; -fx-text-fill: #111827;"/>
    </HBox>

    <!-- ── Form body ───────────────────────────────────────────────────── -->
    <VBox spacing="14" style="-fx-padding: 20 24 20 24;">

        <!-- Tiêu đề -->
        <VBox spacing="4">
            <Label text="Tiêu đề *"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                          -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextField fx:id="txtTitle"
                       promptText="Nhập tiêu đề báo cáo..."
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                              -fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #D1D5DB; -fx-padding: 8 10 8 10;"/>
        </VBox>

        <!-- Mô tả -->
        <VBox spacing="4">
            <Label text="Mô tả"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                          -fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextArea fx:id="txtDescription"
                      promptText="Mô tả chi tiết sự cố / phản hồi..."
                      prefRowCount="4"
                      wrapText="true"
                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                             -fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #D1D5DB; -fx-padding: 8 10 8 10;"/>
        </VBox>

        <!-- Loại báo cáo + Mức độ (2 cột) -->
        <GridPane hgap="12" vgap="4">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <Label text="Loại báo cáo *"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                          -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label text="Mức độ *"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                          -fx-font-weight: bold; -fx-text-fill: #374151;"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <ComboBox fx:id="cmbType"
                      maxWidth="Infinity"
                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;"
                      GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbSeverity"
                      maxWidth="Infinity"
                      style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Error label -->
        <Label fx:id="lblError"
               text=""
               visible="false" managed="false"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                      -fx-text-fill: #DC2626; -fx-font-style: italic;"/>

    </VBox>

    <!-- ── Footer buttons ──────────────────────────────────────────────── -->
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-padding: 12 24 18 24; -fx-background-color: #F9FAFB;
                 -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
        <Button text="Hủy"
                onAction="#cancel"
                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                       -fx-background-color: white; -fx-border-color: #D1D5DB;
                       -fx-border-radius: 8; -fx-background-radius: 8;
                       -fx-padding: 8 18 8 18; -fx-cursor: hand;"/>
        <Button fx:id="btnSubmit"
                text="Gửi báo cáo"
                onAction="#submit"
                defaultButton="true"
                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                       -fx-font-weight: bold; -fx-background-color: #3B82F6;
                       -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 8 18 8 18; -fx-cursor: hand;"/>
    </HBox>

</VBox>
