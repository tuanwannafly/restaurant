<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  CashierPaymentDialog.fxml — Phase 10 · Thu ngân – Dialog thanh toán
  ──────────────────────────────────────────────────────────────────────────────
  Layout thực tế nhà hàng:
    BorderPane
    ├── NORTH  : header (tên bàn + giờ mở bàn)
    ├── CENTER : ScrollPane → VBox
    │              ├── itemsContainer (danh sách món)
    │              ├── Separator
    │              ├── lblSubtotal / lblVat / lblGrandTotal
    │              ├── Separator
    │              ├── cbMethod (phương thức thanh toán)
    │              ├── cashPanel (tiền mặt: tiền nhận + tiền thừa)
    │              ├── Separator
    │              └── cbEmployee (nhân viên thu ngân)
    └── SOUTH  : footer [In hóa đơn] [←] [spacer] [Thực hiện]

  Controller : CashierPaymentDialogController
-->

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurant.ui.fx.controller.CashierPaymentDialogController"
            styleClass="dialog-root"
            prefWidth="520" prefHeight="640">

    <!-- ═══════════════════════ NORTH — Header ═══════════════════════════════ -->
    <top>
        <VBox styleClass="dialog-header" alignment="CENTER" prefHeight="80">
            <Label fx:id="lblTableName" text="Bàn --"
                   styleClass="dialog-header-title"/>
            <Label fx:id="lblCreatedTime" text=""
                   style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <!-- ═══════════════════════ CENTER — Body ════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="edge-to-edge" style="-fx-background-color: transparent;">
            <VBox spacing="0" styleClass="dialog-body">
                <padding><Insets top="20" right="28" bottom="8" left="28"/></padding>

                <!-- ── Tiêu đề danh sách món ── -->
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 6 0;">
                    <Label text="DANH SÁCH MÓN"
                           style="-fx-font-size: 11px; -fx-font-weight: bold;
                                  -fx-text-fill: #64748b; -fx-letter-spacing: 0.5px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Header cột -->
                    <Label text="Số lượng · Đơn giá"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-min-width:130;"/>
                    <Label text="Thành tiền"
                           style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-min-width:90; -fx-alignment: CENTER_RIGHT;"/>
                </HBox>

                <!-- ── Danh sách món (build động bởi controller) ── -->
                <VBox fx:id="itemsContainer" spacing="0"
                      style="-fx-border-color: #e2e8f0; -fx-border-radius: 8;
                             -fx-background-color: #f8fafc; -fx-background-radius: 8;
                             -fx-padding: 10 12 10 12;"/>

                <Region prefHeight="14"/>
                <Separator styleClass="dialog-separator"/>
                <Region prefHeight="10"/>

                <!-- ── Tạm tính / VAT / Tổng cộng ── -->
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 3 0 3 0;">
                    <Label text="Tạm tính" style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSubtotal" text="0đ"
                           style="-fx-text-fill: #475569; -fx-font-size: 13px;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 3 0 3 0;">
                    <Label text="VAT (10%)" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblVat" text="0đ"
                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                </HBox>

                <Region prefHeight="4"/>
                <Separator styleClass="dialog-separator"/>
                <Region prefHeight="6"/>

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 4 0 4 0;">
                    <Label text="TỔNG CỘNG"
                           style="-fx-text-fill: #0f172a; -fx-font-size: 15px;
                                  -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblGrandTotal" text="0đ"
                           style="-fx-text-fill: #1d4ed8; -fx-font-size: 18px;
                                  -fx-font-weight: bold;"/>
                </HBox>

                <Region prefHeight="14"/>
                <Separator styleClass="dialog-separator"/>
                <Region prefHeight="12"/>

                <!-- ── Phương thức thanh toán ── -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Phương thức:"
                           style="-fx-font-size: 13px; -fx-text-fill: #374151;
                                  -fx-font-weight: bold; -fx-min-width: 110;"/>
                    <ComboBox fx:id="cbMethod"
                              prefWidth="180" prefHeight="32"
                              styleClass="employee-combo"/>
                </HBox>

                <Region prefHeight="10"/>

                <!-- ── Panel tiền mặt (ẩn khi không dùng CASH) ── -->
                <VBox fx:id="cashPanel" spacing="8" visible="true" managed="true"
                      style="-fx-background-color: #f0fdf4; -fx-background-radius: 8;
                             -fx-border-color: #bbf7d0; -fx-border-radius: 8;
                             -fx-padding: 12 14 12 14;">

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Tiền khách đưa:"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151;
                                      -fx-min-width: 120;"/>
                        <TextField fx:id="tfCashReceived"
                                   prefWidth="140" prefHeight="32"
                                   style="-fx-font-size: 13px;"/>
                        <Label text="đ" style="-fx-text-fill: #374151;"/>
                    </HBox>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Tiền thừa:"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151;
                                      -fx-min-width: 120;"/>
                        <Label fx:id="lblChange" text="--"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;
                                      -fx-text-fill: #16a34a;"/>
                    </HBox>
                </VBox>

                <Region prefHeight="14"/>
                <Separator styleClass="dialog-separator"/>
                <Region prefHeight="12"/>

                <!-- ── Nhân viên thu ngân ── -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Nhân viên:"
                           style="-fx-font-size: 13px; -fx-text-fill: #374151;
                                  -fx-font-weight: bold; -fx-min-width: 110;"/>
                    <ComboBox fx:id="cbEmployee"
                              promptText="Chọn nhân viên"
                              prefWidth="200" prefHeight="32"
                              styleClass="employee-combo"
                              disable="true"/>
                </HBox>

                <Region prefHeight="16"/>
            </VBox>
        </ScrollPane>
    </center>

    <!-- ═══════════════════════ SOUTH — Footer ═══════════════════════════════ -->
    <bottom>
        <VBox>
            <Separator styleClass="dialog-separator"/>
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="dialog-footer">
                <padding><Insets top="12" right="24" bottom="16" left="24"/></padding>

                <Button fx:id="btnPrint" text="🖨 In hóa đơn"
                        styleClass="btn-outline"
                        prefWidth="120" prefHeight="36"
                        onAction="#onPrint"/>

                <Button fx:id="btnBack" text="←"
                        styleClass="btn-text-icon"
                        prefWidth="36" prefHeight="36"
                        onAction="#onBack"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnConfirm" text="✓  Xác nhận thanh toán"
                        styleClass="btn-primary"
                        prefWidth="170" prefHeight="36"
                        onAction="#onConfirm"
                        defaultButton="true"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
