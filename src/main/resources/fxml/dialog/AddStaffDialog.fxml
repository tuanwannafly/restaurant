<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  AddStaffDialog.fxml
  Dialog hợp nhất: tạo nhân viên + tài khoản đăng nhập trong một bước.
  Controller: AddStaffDialogController
  Thay thế EmployeeDialog (add mode) + RegisterStaffDialog.
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.ui.dialog.AddStaffDialogController"
      style="-fx-background-color:white;"
      prefWidth="540" spacing="0">

    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" prefHeight="58"
          style="-fx-background-color:#3B82F6;-fx-padding:0 24 0 24;">
        <Label text="Thêm nhân viên mới"
               style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:white;"/>
    </HBox>

    <ScrollPane fitToWidth="true"
                style="-fx-background:white;-fx-background-color:white;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="0" style="-fx-background-color:white;">

            <!-- ══ Phần 1: Thông tin nhân viên ══════════════════════════════ -->
            <Label text="Thông tin nhân viên"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#3B82F6;
                          -fx-padding:20 28 8 28;-fx-background-color:white;"/>

            <GridPane hgap="12" vgap="8"
                      style="-fx-background-color:white;-fx-padding:0 28 16 28;">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" maxWidth="140" halignment="RIGHT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Họ và tên -->
                <Label text="Họ và tên *:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="2">
                    <TextField fx:id="tfName" promptText="Nhập họ và tên..."
                               style="-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                      -fx-background-radius:6;-fx-font-size:13px;
                                      -fx-padding:6 10 6 10;"/>
                    <Label fx:id="errName" text="" visible="false" managed="false"
                           style="-fx-font-size:11px;-fx-text-fill:#EF4444;"/>
                </VBox>

                <!-- CCCD -->
                <Label text="CCCD:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <TextField fx:id="tfCccd" promptText="12 chữ số"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                  -fx-background-radius:6;-fx-font-size:13px;
                                  -fx-padding:6 10 6 10;"/>

                <!-- SDT -->
                <Label text="SDT *:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="2">
                    <TextField fx:id="tfPhone" promptText="0xxxxxxxxx"
                               style="-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                      -fx-background-radius:6;-fx-font-size:13px;
                                      -fx-padding:6 10 6 10;"/>
                    <Label fx:id="errPhone" text="" visible="false" managed="false"
                           style="-fx-font-size:11px;-fx-text-fill:#EF4444;"/>
                </VBox>

                <!-- Địa chỉ -->
                <Label text="Địa chỉ:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <TextField fx:id="tfAddress" promptText="Địa chỉ..."
                           GridPane.columnIndex="1" GridPane.rowIndex="3"
                           style="-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                  -fx-background-radius:6;-fx-font-size:13px;
                                  -fx-padding:6 10 6 10;"/>

                <!-- Ngày vào làm -->
                <Label text="Ngày vào làm:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <DatePicker fx:id="dpStartDate"
                            GridPane.columnIndex="1" GridPane.rowIndex="4"
                            maxWidth="Infinity"
                            style="-fx-font-size:13px;"/>

                <!-- Vai trò -->
                <Label text="Vai trò *:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="5" spacing="2">
                    <ComboBox fx:id="cmbRole" maxWidth="Infinity"
                              style="-fx-font-size:13px;"/>
                    <Label fx:id="errRole" text="" visible="false" managed="false"
                           style="-fx-font-size:11px;-fx-text-fill:#EF4444;"/>
                </VBox>
            </GridPane>

            <!-- Divider -->
            <Separator style="-fx-padding:0 28 0 28;"/>

            <!-- ══ Phần 2: Tài khoản đăng nhập ══════════════════════════════ -->
            <Label text="Tài khoản đăng nhập"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#3B82F6;
                          -fx-padding:16 28 8 28;-fx-background-color:white;"/>

            <GridPane hgap="12" vgap="8"
                      style="-fx-background-color:white;-fx-padding:0 28 16 28;">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" maxWidth="140" halignment="RIGHT"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Email -->
                <Label text="Email *:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="2">
                    <TextField fx:id="tfEmail" promptText="name@example.com"
                               style="-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                      -fx-background-radius:6;-fx-font-size:13px;
                                      -fx-padding:6 10 6 10;"/>
                    <Label fx:id="errEmail" text="" visible="false" managed="false"
                           style="-fx-font-size:11px;-fx-text-fill:#EF4444;"/>
                </VBox>

                <!-- Mật khẩu -->
                <Label text="Mật khẩu *:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="2">
                    <PasswordField fx:id="pfPassword" promptText="Tối thiểu 6 ký tự"
                                   style="-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                          -fx-background-radius:6;-fx-font-size:13px;
                                          -fx-padding:6 10 6 10;"/>
                    <Label fx:id="errPassword" text="" visible="false" managed="false"
                           style="-fx-font-size:11px;-fx-text-fill:#EF4444;"/>
                </VBox>

                <!-- Xác nhận mật khẩu -->
                <Label text="Xác nhận *:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                       style="-fx-font-size:13px;-fx-text-fill:#374151;"/>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="2">
                    <PasswordField fx:id="pfConfirm" promptText="Nhập lại mật khẩu"
                                   style="-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                          -fx-background-radius:6;-fx-font-size:13px;
                                          -fx-padding:6 10 6 10;"/>
                    <Label fx:id="errConfirm" text="" visible="false" managed="false"
                           style="-fx-font-size:11px;-fx-text-fill:#EF4444;"/>
                </VBox>
            </GridPane>

            <!-- Info box -->
            <HBox spacing="8" alignment="TOP_LEFT"
                  style="-fx-background-color:#EFF6FF;-fx-border-color:#BFDBFE;
                         -fx-border-radius:0;-fx-padding:10 28 10 28;">
                <Label text="ℹ️" style="-fx-font-size:14px;"/>
                <Label fx:id="lblInfo"
                       text="Nhân viên có thể đăng nhập ngay sau khi tạo."
                       wrapText="true"
                       style="-fx-font-size:12px;-fx-text-fill:#1E293B;"/>
            </HBox>

        </VBox>
    </ScrollPane>

    <!-- ── Footer ───────────────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_RIGHT" spacing="10" prefHeight="56"
          style="-fx-background-color:white;
                 -fx-border-color:#E2E8F0 transparent transparent transparent;
                 -fx-padding:0 24 0 24;">
        <Button text="Hủy" onAction="#onCancel"
                prefWidth="90" prefHeight="34"
                style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-radius:6;
                       -fx-background-radius:6;-fx-font-size:13px;-fx-cursor:hand;"/>
        <Button fx:id="btnSave" text="Tạo nhân viên →" onAction="#onSave"
                prefWidth="160" prefHeight="34"
                style="-fx-background-color:#3B82F6;-fx-text-fill:white;-fx-background-radius:6;
                       -fx-border-radius:6;-fx-font-size:13px;-fx-cursor:hand;"/>
    </HBox>
</VBox>
