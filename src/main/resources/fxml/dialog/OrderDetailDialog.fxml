<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<DialogPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurant.ui.dialog.OrderDetailController"
            prefWidth="560" prefHeight="500"
            styleClass="order-detail-dialog">

    <header>
        <Label fx:id="lblTitle" text="Chi tiết đơn hàng" styleClass="dialog-title">
            <font><Font name="System Bold" size="16.0"/></font>
        </Label>
    </header>

    <content>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="detail-scroll">
            <!-- fx:id="contentVBox" dùng để inject InlineErrorBarFx lúc runtime -->
            <VBox fx:id="contentVBox" spacing="10">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

                <!-- Thông tin cơ bản đơn hàng -->
                <GridPane hgap="12" vgap="8" styleClass="info-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Mã đơn:" styleClass="info-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblOrderId" styleClass="info-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Bàn:" styleClass="info-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblTableName" styleClass="info-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Trạng thái:" styleClass="info-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblStatus" styleClass="info-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Thời gian tạo:" styleClass="info-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Label fx:id="lblCreatedAt" styleClass="info-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Ghi chú:" styleClass="info-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <Label fx:id="lblNote" wrapText="true" styleClass="info-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <Separator/>

                <!-- Danh sách món -->
                <Label text="Danh sách món" styleClass="section-title">
                    <font><Font name="System Bold" size="14.0"/></font>
                </Label>

                <TableView fx:id="tableItems" prefHeight="200" styleClass="items-table">
                    <columns>
                        <TableColumn fx:id="colItemName"  text="Tên món"   prefWidth="220"/>
                        <TableColumn fx:id="colQuantity"  text="Số lượng"  prefWidth="80"  style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colUnitPrice" text="Đơn giá"   prefWidth="110" style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="colSubtotal"  text="Thành tiền" prefWidth="110" style="-fx-alignment: CENTER-RIGHT;"/>
                    </columns>
                    <placeholder><Label text="Không có món nào"/></placeholder>
                </TableView>

                <!-- Tổng tiền -->
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label text="Tổng cộng:" styleClass="total-label">
                        <font><Font name="System Bold" size="14.0"/></font>
                    </Label>
                    <Label fx:id="lblTotal" styleClass="total-value" style="-fx-text-fill: #e74c3c;">
                        <font><Font name="System Bold" size="14.0"/></font>
                    </Label>
                </HBox>
            </VBox>
        </ScrollPane>
    </content>

    <!-- ── Footer buttons ─────────────────────────────────────────────────── -->
    <buttonTypes/>
    <expandableContent>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>

            <!-- [THÊM MỚI] Nút Huỷ đơn — chỉ hiện khi status PENDING/ACCEPTED và có quyền -->
            <Button fx:id="btnCancelOrder"
                    text="Huỷ đơn"
                    styleClass="btn-danger"
                    prefWidth="110"
                    onAction="#handleCancelOrder"
                    visible="false"
                    managed="false"/>

            <Button fx:id="btnClose"
                    text="Đóng"
                    styleClass="btn-secondary"
                    prefWidth="90"
                    defaultButton="true"
                    onAction="#onClose"/>
        </HBox>
    </expandableContent>
</DialogPane>
