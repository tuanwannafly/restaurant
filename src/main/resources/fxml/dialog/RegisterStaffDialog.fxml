<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  RegisterStaffDialog.fxml
  Allows a RESTAURANT_ADMIN to create a login account for a new staff member.
  Business rules enforced in RegisterStaffDialogController:
    • Validate all fields before issuing an Operation Token
    • Operation Token must be confirmed (ConfirmOperationDialog) before registerStaff() is called
    • isSuccess() returns true only after the background task completes without error
-->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.ui.dialog.RegisterStaffDialogController"
      style="-fx-background-color:white;"
      prefWidth="460" spacing="0">

    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_LEFT" prefHeight="58"
          style="-fx-background-color:#3B82F6;-fx-padding:0 24 0 24;">
        <Label text="Tạo tài khoản nhân viên"
               style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:white;"/>
    </HBox>

    <!-- ── Form ─────────────────────────────────────────────────────────────── -->
    <VBox spacing="14" style="-fx-padding:24 36 12 36;-fx-background-color:white;"
          VBox.vgrow="ALWAYS">

        <!-- Họ và tên -->
        <VBox spacing="5">
            <Label text="Họ và tên *"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
            <TextField fx:id="tfName" promptText="Nhập họ và tên..."
                       style="-fx-font-size:13px;-fx-border-color:#CBD5E1;-fx-border-radius:6;
                              -fx-background-radius:6;-fx-padding:6 10 6 10;"/>
        </VBox>

        <!-- Email đăng nhập -->
        <VBox spacing="5">
            <Label text="Email đăng nhập *"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
            <TextField fx:id="tfEmail" promptText="name@example.com"
                       style="-fx-font-size:13px;-fx-border-color:#CBD5E1;-fx-border-radius:6;
                              -fx-background-radius:6;-fx-padding:6 10 6 10;"/>
        </VBox>

        <!-- Mật khẩu -->
        <VBox spacing="5">
            <Label text="Mật khẩu *"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
            <PasswordField fx:id="pfPassword" promptText="Tối thiểu 6 ký tự"
                           style="-fx-font-size:13px;-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                  -fx-background-radius:6;-fx-padding:6 10 6 10;"/>
        </VBox>

        <!-- Xác nhận mật khẩu -->
        <VBox spacing="5">
            <Label text="Xác nhận mật khẩu *"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
            <PasswordField fx:id="pfConfirm" promptText="Nhập lại mật khẩu"
                           style="-fx-font-size:13px;-fx-border-color:#CBD5E1;-fx-border-radius:6;
                                  -fx-background-radius:6;-fx-padding:6 10 6 10;"/>
        </VBox>

        <!-- Vai trò -->
        <VBox spacing="5">
            <Label text="Vai trò *"
                   style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
            <ComboBox fx:id="cmbRole" maxWidth="Infinity"
                      style="-fx-font-size:13px;"/>
        </VBox>

        <!-- Info box -->
        <HBox fx:id="infoBox" spacing="8" alignment="TOP_LEFT"
              style="-fx-background-color:#EFF6FF;-fx-border-color:#BFDBFE;
                     -fx-border-radius:6;-fx-background-radius:6;
                     -fx-padding:10 14 10 14;">
            <Label text="ℹ️" style="-fx-font-size:14px;"/>
            <VBox spacing="3">
                <Label fx:id="lblInfoRestaurant" text="Tài khoản sẽ được tạo cho nhà hàng: ..."
                       style="-fx-font-size:12px;-fx-text-fill:#1E293B;"/>
                <Label text="Nhân viên có thể đăng nhập ngay sau khi tạo."
                       style="-fx-font-size:12px;-fx-text-fill:#64748B;"/>
            </VBox>
        </HBox>

        <!-- Error label -->
        <Label fx:id="lblError" text=""
               style="-fx-font-size:12px;-fx-text-fill:#EF4444;"/>
    </VBox>

    <!-- ── Footer ───────────────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_RIGHT" spacing="10" prefHeight="56"
          style="-fx-border-color:#E2E8F0 transparent transparent transparent;
                 -fx-padding:0 24 0 24;-fx-background-color:white;">
        <Button text="Hủy" onAction="#onCancel"
                prefWidth="90" prefHeight="34"
                style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-radius:6;
                       -fx-background-radius:6;-fx-font-size:13px;-fx-cursor:hand;"/>
        <Button fx:id="btnSubmit" text="Tạo tài khoản →" onAction="#onSubmit"
                prefWidth="150" prefHeight="34"
                style="-fx-background-color:#3B82F6;-fx-text-fill:white;-fx-background-radius:6;
                       -fx-border-radius:6;-fx-font-size:13px;-fx-cursor:hand;"/>
    </HBox>
</VBox>
