<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.restaurant.ui.control.CleanField?>

<!--
  MyRestaurantView.fxml
  Vị trí: src/main/resources/fxml/MyRestaurantView.fxml
  Controller: com.restaurant.ui.fx.controller.MyRestaurantController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurant.ui.fx.controller.MyRestaurantController"
            styleClass="page-root"
            stylesheets="@../css/app.css">

    <!-- ══════════════════════════════════════════════════════
         PAGE HEADER
         ══════════════════════════════════════════════════════ -->
    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">

            <!-- LEFT: title + breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Thông tin nhà hàng" styleClass="page-title"/>
                <Label text="·" styleClass="sep-dot"/>
                <Label fx:id="lblHeaderName" text="Đang tải..." styleClass="header-sub"/>
                <Label text="·" styleClass="sep-dot"/>
                <Label fx:id="lblStatus" text="● Hoạt động" styleClass="badge-success"/>
            </HBox>

            <!-- SPACER -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- RIGHT: status msg + buttons -->
            <Label fx:id="lblMsg" styleClass="msg-label"/>
            <Button fx:id="btnReset" text="Đặt lại" styleClass="btn-outline"
                    onAction="#onReset"/>
            <Button fx:id="btnSave"  text="Lưu thay đổi" styleClass="btn-primary"
                    onAction="#onSave"/>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════════════════
         BODY (ScrollPane → GridPane 2 cột)
         ══════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="body-scroll">
            <padding><Insets top="20" right="24" bottom="24" left="24"/></padding>

            <GridPane hgap="16" vgap="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="60" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="40" hgrow="ALWAYS"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="SOMETIMES"/>
                </rowConstraints>

                <!-- ══ LEFT CARD: Thông tin cơ bản ══════════════════════════ -->
                <VBox styleClass="card" spacing="0"
                      GridPane.columnIndex="0" GridPane.rowIndex="0">

                    <Label text="THÔNG TIN CƠ BẢN" styleClass="section-label"/>

                    <GridPane styleClass="form-grid" hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="130" maxWidth="130"/>
                            <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                        </columnConstraints>

                        <!-- Tên nhà hàng -->
                        <Label text="Tên nhà hàng" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"
                               GridPane.valignment="CENTER"/>
                        <CleanField fx:id="tfName"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0"
                                    maxWidth="1.7976931348623157E308"/>

                        <!-- Địa chỉ -->
                        <Label text="Địa chỉ" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"
                               GridPane.valignment="CENTER"/>
                        <CleanField fx:id="tfAddress"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1"
                                    maxWidth="1.7976931348623157E308"/>

                        <!-- Số điện thoại -->
                        <Label text="Số điện thoại" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"
                               GridPane.valignment="CENTER"/>
                        <CleanField fx:id="tfPhone"
                                    GridPane.columnIndex="1" GridPane.rowIndex="2"
                                    maxWidth="1.7976931348623157E308"/>

                        <!-- Email -->
                        <Label text="Email liên hệ" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="3"
                               GridPane.valignment="CENTER"/>
                        <CleanField fx:id="tfEmail"
                                    GridPane.columnIndex="1" GridPane.rowIndex="3"
                                    maxWidth="1.7976931348623157E308"/>

                        <!-- Mô tả -->
                        <Label text="Mô tả ngắn" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="4"
                               GridPane.valignment="TOP"/>
                        <TextArea fx:id="taDesc" wrapText="true"
                                  prefRowCount="3" styleClass="clean-textarea"
                                  GridPane.columnIndex="1" GridPane.rowIndex="4"
                                  maxWidth="1.7976931348623157E308"/>

                        <!-- Ngày tạo (read-only) -->
                        <Label text="Ngày tạo" styleClass="field-label"
                               GridPane.columnIndex="0" GridPane.rowIndex="5"
                               GridPane.valignment="CENTER"/>
                        <Label fx:id="lblCreatedAt" text="—" styleClass="readonly-value"
                               GridPane.columnIndex="1" GridPane.rowIndex="5"
                               GridPane.valignment="CENTER"/>
                    </GridPane>
                </VBox>

                <!-- ══ RIGHT COLUMN ═════════════════════════════════════════ -->
                <VBox spacing="12"
                      GridPane.columnIndex="1" GridPane.rowIndex="0">

                    <!-- LOGO CARD -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="LOGO NHÀ HÀNG" styleClass="section-label"/>

                        <HBox spacing="14" alignment="CENTER_LEFT">

                            <!-- Avatar circle -->
                            <StackPane fx:id="logoPane" styleClass="logo-circle"
                                       prefWidth="64" prefHeight="64"
                                       minWidth="64" minHeight="64"
                                       onMouseClicked="#onPickLogo"
                                       cursor="HAND">
                                <Label fx:id="lblLogoInitials" text="NH"
                                       styleClass="logo-initials"/>
                                <ImageView fx:id="imgLogo" fitWidth="64" fitHeight="64"
                                           visible="false" managed="false"
                                           preserveRatio="false" smooth="true"
                                           styleClass="logo-img"/>
                            </StackPane>

                            <!-- Upload actions -->
                            <VBox spacing="6" alignment="CENTER_LEFT">
                                <Button fx:id="btnUpload" text="Tải lên"
                                        styleClass="btn-outline-sm"
                                        onAction="#onPickLogo"/>
                                <Label text="JPG, PNG — tối đa 2 MB"
                                       styleClass="hint-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- HOURS CARD -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="GIỜ HOẠT ĐỘNG" styleClass="section-label"/>

                        <GridPane hgap="0" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                                <ColumnConstraints hgrow="ALWAYS" fillWidth="true"/>
                            </columnConstraints>

                            <Label text="Thứ 2 – 6" styleClass="hours-day"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label text="07:00 – 22:00" styleClass="hours-open"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"
                                   GridPane.halignment="RIGHT"/>

                            <Label text="Thứ 7" styleClass="hours-day"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label text="08:00 – 23:00" styleClass="hours-open"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"
                                   GridPane.halignment="RIGHT"/>

                            <Label text="Chủ nhật" styleClass="hours-day"
                                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label text="Đóng cửa" styleClass="hours-closed"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"
                                   GridPane.halignment="RIGHT"/>
                        </GridPane>
                    </VBox>

                </VBox>
            </GridPane>
        </ScrollPane>
    </center>
</BorderPane>
