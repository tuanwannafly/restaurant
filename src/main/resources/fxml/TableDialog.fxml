<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.restaurant.ui.dialog.TableDialogController"
      spacing="16" style="-fx-padding: 24; -fx-background-color: white;"
      minWidth="340">

    <Label fx:id="lblTitle" text="Thêm bàn mới"
           style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <VBox spacing="4">
        <Label text="Tên bàn *"/>
        <TextField fx:id="tfName" promptText="VD: Bàn 01"/>
        <Label fx:id="errName" style="-fx-text-fill: red; -fx-font-size: 11;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Sức chứa *"/>
        <TextField fx:id="tfCapacity" promptText="VD: 4"/>
        <Label fx:id="errCapacity" style="-fx-text-fill: red; -fx-font-size: 11;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Trạng thái"/>
        <ComboBox fx:id="cbStatus" maxWidth="Infinity"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Hủy"     onAction="#onCancel"
                style="-fx-background-color: #E5E7EB;"/>
        <Button text="Lưu"     onAction="#onSave"
                style="-fx-background-color: #3B82F6; -fx-text-fill: white;"/>
    </HBox>
</VBox>