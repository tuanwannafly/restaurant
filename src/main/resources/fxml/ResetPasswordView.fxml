<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  ResetPasswordView.fxml — SmartRestaurant  (Phase 3d)
  Modal window: 420 × 440  (set on Stage by ForgotPasswordController)

  Layout:
    ┌──────────────────────────────────────────┐
    │  ✉  Đặt lại mật khẩu                    │  header band
    │     Nhập mã OTP và mật khẩu mới          │
    ├──────────────────────────────────────────┤
    │  Mã OTP  ────────────────────────────    │
    │  [______]  (6 số)                        │
    │  Mật khẩu mới  ──────────────────────    │
    │  [**********]                            │
    │  Xác nhận mật khẩu  ─────────────────    │
    │  [**********]                            │
    │  lblError  (error)                       │
    │  [ Đặt lại mật khẩu          ]          │
    │  ← Quay lại                              │
    └──────────────────────────────────────────┘
-->
<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.restaurant.ui.fx.controller.ResetPasswordController"
    styleClass="fp-root"
    stylesheets="@login.css">

    <VBox spacing="0">

        <!-- ══ HEADER BAND ══════════════════════════════════════════════ -->
        <VBox styleClass="fp-header-band" alignment="CENTER" spacing="6"
              prefHeight="110">
            <Label text="✉" styleClass="fp-header-icon"/>
            <Label text="Đặt lại mật khẩu" styleClass="fp-header-title"/>
            <Label fx:id="lblEmailHint"
                   text="Nhập mã OTP đã gửi đến email của bạn"
                   styleClass="fp-header-hint" wrapText="true"
                   maxWidth="340"/>
        </VBox>

        <!-- ══ FORM CARD ════════════════════════════════════════════════ -->
        <VBox styleClass="fp-form-card" spacing="0" VBox.vgrow="ALWAYS">

            <Region prefHeight="20"/>

            <!-- ── OTP field ── -->
            <Label text="Mã OTP (6 số)" styleClass="login-field-label"/>
            <Region prefHeight="6"/>
            <HBox styleClass="login-field-box" fx:id="boxOtp">
                <TextField fx:id="tfOtp"
                           promptText="Nhập mã 6 số trong email"
                           styleClass="login-text-field"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region prefHeight="14"/>

            <!-- ── New password field ── -->
            <Label text="Mật khẩu mới" styleClass="login-field-label"/>
            <Region prefHeight="6"/>
            <HBox styleClass="login-field-box" fx:id="boxNewPass">
                <PasswordField fx:id="pfNewPassword"
                               promptText="Tối thiểu 6 ký tự"
                               styleClass="login-text-field"
                               HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region prefHeight="14"/>

            <!-- ── Confirm password field ── -->
            <Label text="Xác nhận mật khẩu mới" styleClass="login-field-label"/>
            <Region prefHeight="6"/>
            <HBox styleClass="login-field-box" fx:id="boxConfirmPass">
                <PasswordField fx:id="pfConfirmPassword"
                               promptText="Nhập lại mật khẩu mới"
                               styleClass="login-text-field"
                               HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region prefHeight="14"/>

            <!-- ── Error label ── -->
            <Label fx:id="lblError"
                   styleClass="login-error-label"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

            <!-- ── Reset password button ── -->
            <Button fx:id="btnReset"
                    text="Đặt lại mật khẩu"
                    styleClass="login-btn-primary"
                    maxWidth="Infinity"
                    onAction="#onResetPassword"/>

            <Region prefHeight="14"/>

            <!-- ── Back link ── -->
            <HBox alignment="CENTER">
                <Button text="← Quay lại"
                        styleClass="login-link-btn"
                        onAction="#onCancel"
                        focusTraversable="false"/>
            </HBox>

            <Region prefHeight="20"/>
        </VBox>

    </VBox>
</StackPane>
