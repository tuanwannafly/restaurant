<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  ForgotPasswordView.fxml — SmartRestaurant  (Phase 3c)
  Modal window: 420 × 330  (set on Stage by LoginController)

  Layout:
    ┌──────────────────────────────────────────┐
    │  🔒  Quên mật khẩu                       │  header band
    │      Nhập email để nhận mã OTP            │
    ├──────────────────────────────────────────┤
    │  Email  ─────────────────────────────    │
    │  [email@example.com             ]        │
    │  lblMessage  (error / success)           │
    │  [ Gửi mã xác nhận             ]        │
    │  ← Quay lại đăng nhập                    │
    └──────────────────────────────────────────┘
-->
<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    styleClass="fp-root"
    stylesheets="@login.css">

    <VBox spacing="0">

        <!-- ══ HEADER BAND ══════════════════════════════════════════════ -->
        <VBox styleClass="fp-header-band" alignment="CENTER" spacing="6"
              prefHeight="110">
            <Label text="🔒" styleClass="fp-header-icon"/>
            <Label text="Quên mật khẩu" styleClass="fp-header-title"/>
            <Label text="Nhập email tài khoản để nhận mã OTP" styleClass="fp-header-hint"/>
        </VBox>

        <!-- ══ FORM CARD ════════════════════════════════════════════════ -->
        <VBox styleClass="fp-form-card" spacing="0" VBox.vgrow="ALWAYS">

            <Region prefHeight="24"/>

            <!-- ── Email field ── -->
            <Label text="Email" styleClass="login-field-label"/>
            <Region prefHeight="6"/>
            <HBox styleClass="login-field-box" fx:id="boxEmail">
                <TextField fx:id="tfEmail"
                           promptText="Nhập địa chỉ email đã đăng ký"
                           styleClass="login-text-field"
                           HBox.hgrow="ALWAYS"/>
            </HBox>

            <Region prefHeight="14"/>

            <!-- ── Message label (error / success) ── -->
            <Label fx:id="lblMessage"
                   styleClass="login-error-label"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

            <!-- ── Send OTP button ── -->
            <Button fx:id="btnSend"
                    text="Gửi mã xác nhận"
                    styleClass="login-btn-primary"
                    maxWidth="Infinity"
                    onAction="#onSendOtp"/>

            <Region prefHeight="14"/>

            <!-- ── Back link ── -->
            <HBox alignment="CENTER">
                <Button text="← Quay lại đăng nhập"
                        styleClass="login-link-btn"
                        onAction="#onCancel"
                        focusTraversable="false"/>
            </HBox>

            <Region prefHeight="20"/>
        </VBox>

    </VBox>
</StackPane>
