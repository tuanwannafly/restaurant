<?xml version="1.0" encoding="UTF-8"?>

<!--
  HomeView.fxml  (REDESIGNED)
  Dashboard chính — SUPER_ADMIN / RESTAURANT_ADMIN
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import com.restaurant.ui.StatCard?>

<ScrollPane
    fitToWidth="true"
    hbarPolicy="NEVER"
    styleClass="home-scroll"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.restaurant.ui.HomeController">

    <VBox spacing="0" styleClass="home-root" maxWidth="Infinity">

        <!-- ── Header Banner ───────────────────────────────────── -->
        <HBox styleClass="home-header-banner" alignment="CENTER_LEFT" spacing="0">
            <padding><Insets top="26" right="48" bottom="26" left="48"/></padding>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="lblGreeting" styleClass="home-greeting"/>
                <Label fx:id="lblSubtitle" styleClass="home-subtitle"/>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="6">
                <Label fx:id="lblRefreshDot" text="●" styleClass="home-dot"/>
                <Label fx:id="lblRefreshText" text="Cập nhật sau: 30s"
                       styleClass="home-refresh-text"/>
            </HBox>
        </HBox>

        <!-- ── Body ────────────────────────────────────────────── -->
        <VBox spacing="0" styleClass="home-body">
            <padding><Insets top="28" right="48" bottom="36" left="48"/></padding>

            <!-- Section label: Stats -->
            <HBox styleClass="home-section-row" alignment="CENTER_LEFT" spacing="12">
                <Region styleClass="home-section-accent"/>
                <Label text="TỔNG QUAN HỆ THỐNG" styleClass="home-section-label"/>
                <VBox.margin><Insets bottom="16"/></VBox.margin>
            </HBox>

            <!-- 2x2 Stat-card grid -->
            <GridPane fx:id="cardsGrid" hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="136" prefHeight="144"/>
                    <RowConstraints minHeight="136" prefHeight="144"/>
                </rowConstraints>

                <StatCard fx:id="cardActive"  maxWidth="Infinity"
                          GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                <StatCard fx:id="cardNew"     maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.hgrow="ALWAYS"/>
                <StatCard fx:id="cardRevenue" maxWidth="Infinity"
                          GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS"/>
                <StatCard fx:id="cardOrders"  maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.hgrow="ALWAYS"/>

                <VBox.margin><Insets bottom="32"/></VBox.margin>
            </GridPane>

            <!-- Section label: Activity -->
            <HBox styleClass="home-section-row" alignment="CENTER_LEFT" spacing="12">
                <Region styleClass="home-section-accent"/>
                <Label text="HOAT DONG GAN DAY" styleClass="home-section-label"/>
                <VBox.margin><Insets bottom="14"/></VBox.margin>
            </HBox>

            <!-- Activity card container -->
            <VBox styleClass="home-activity-card">
                <ListView fx:id="activityList"
                          prefHeight="222"
                          maxWidth="Infinity"
                          styleClass="home-activity-list"/>
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>
