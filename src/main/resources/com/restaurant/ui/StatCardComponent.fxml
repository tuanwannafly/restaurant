<?xml version="1.0" encoding="UTF-8"?>

<!--
  StatCardComponent.fxml  (REDESIGNED v3)
  Modern stat card: full-width accent top bar, large icon badge, bold value.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.VBox"
         spacing="0"
         maxWidth="Infinity"
         xmlns:fx="http://javafx.com/fxml/1">

    <!-- Top accent strip (colour set programmatically) -->
    <Region fx:id="accentBar" prefHeight="4" maxWidth="Infinity"/>

    <!-- Card body -->
    <HBox alignment="CENTER_LEFT" spacing="18" VBox.vgrow="ALWAYS">
        <padding><Insets top="20" right="22" bottom="22" left="22"/></padding>

        <!-- Icon badge drawn on canvas -->
        <StackPane prefWidth="64" prefHeight="64" minWidth="64" minHeight="64">
            <Canvas fx:id="iconCanvas" width="64" height="64"/>
        </StackPane>

        <!-- Value + subtitle -->
        <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label fx:id="lblValue"
                   text="—"
                   style="-fx-font-family: 'Segoe UI Semibold', 'Segoe UI';
                          -fx-font-size: 30;
                          -fx-font-weight: bold;
                          -fx-text-fill: #0F172A;"/>
            <Label fx:id="lblTitle"
                   text=""
                   style="-fx-font-family: 'Segoe UI';
                          -fx-font-size: 12;
                          -fx-text-fill: #64748B;"/>
        </VBox>
    </HBox>

</fx:root>
