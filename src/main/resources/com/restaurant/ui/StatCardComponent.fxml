<?xml version="1.0" encoding="UTF-8"?>

<!--
  StatCardComponent.fxml
  Reusable stat card — loaded by StatCard.java (fx:root pattern).

  Structure (HBox root):
    ├─ Canvas  (38×38) — icon drawn with GraphicsContext; Java2D-style shapes, no emoji
    └─ VBox
         ├─ Label  lblValue   (large bold number / formatted string)
         └─ Label  lblTitle   (small descriptor)

  Accent border and drop-shadow are applied programmatically by StatCard.configure().
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.HBox"
         alignment="CENTER_LEFT"
         spacing="14"
         maxWidth="Infinity"
         xmlns:fx="http://javafx.com/fxml/1">

    <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>

    <!-- Icon circle — drawn programmatically in StatCard.drawIcon() -->
    <Canvas fx:id="iconCanvas" width="38" height="38"/>

    <!-- Value + title -->
    <VBox spacing="2" HBox.hgrow="ALWAYS">
        <Label fx:id="lblValue"
               text="—"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
        <Label fx:id="lblTitle"
               text=""
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #6B7280;"/>
    </VBox>

</fx:root>
