<?xml version="1.0" encoding="UTF-8"?>

<!--
  StatCardComponent.fxml  (REDESIGNED v2)
  Reusable stat card — loaded by StatCard.java (fx:root pattern).
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.HBox"
         alignment="CENTER_LEFT"
         spacing="20"
         maxWidth="Infinity"
         xmlns:fx="http://javafx.com/fxml/1">

    <padding><Insets top="24" right="26" bottom="24" left="24"/></padding>

    <!-- Icon circle — drawn programmatically in StatCard.drawIcon() -->
    <Canvas fx:id="iconCanvas" width="56" height="56"/>

    <!-- Value + title -->
    <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
        <Label fx:id="lblValue"
               text="—"
               style="-fx-font-family: 'Segoe UI Semibold', 'Segoe UI';
                      -fx-font-size: 34;
                      -fx-font-weight: bold;
                      -fx-text-fill: #0F172A;"/>
        <Label fx:id="lblTitle"
               text=""
               style="-fx-font-family: 'Segoe UI';
                      -fx-font-size: 12.5;
                      -fx-text-fill: #94A3B8;"/>
    </VBox>

</fx:root>
