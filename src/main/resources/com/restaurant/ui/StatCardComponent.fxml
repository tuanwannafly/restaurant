<?xml version="1.0" encoding="UTF-8"?>

<!--
  StatCardComponent.fxml  (REDESIGNED)
  Reusable stat card — loaded by StatCard.java (fx:root pattern).
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.HBox"
         alignment="CENTER_LEFT"
         spacing="16"
         maxWidth="Infinity"
         xmlns:fx="http://javafx.com/fxml/1">

    <padding><Insets top="22" right="24" bottom="22" left="22"/></padding>

    <!-- Icon circle — drawn programmatically in StatCard.drawIcon() -->
    <Canvas fx:id="iconCanvas" width="52" height="52"/>

    <!-- Value + title -->
    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="lblValue"
               text="—"
               style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 30;
                      -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <Label fx:id="lblTitle"
               text=""
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;
                      -fx-text-fill: #94A3B8;"/>
    </VBox>

</fx:root>
